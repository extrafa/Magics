    "instruction.share.learnMore" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learn magic with Magical Ross"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprende magia con Magical Ross"
          }
        }
      }
    },
    "instruction.share.madeWith" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Made with Magical Ross"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hecho con Magical Ross"
          }
        }
      }
    },
    "instruction.startTrick" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start Trick"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empezar Truco"
          }
        }
      }
    },
    "instruction.time.effect" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The spectator starts and stops a stopwatch whenever they want. Then you say the exact time: seconds and hundredths."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La persona inicia y detiene un cronómetro cuando quiera. Luego dices el tiempo exacto: segundos y centésimas."
          }
        }
      }
    },
    "instruction.time.secret" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When they stop the stopwatch, the phone sends you the time through vibrations: first the seconds, then the hundredths."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando detiene el cronómetro, el teléfono te envía el tiempo con vibraciones: primero los segundos y luego las centésimas."
          }
        }
      }
    },
    "instruction.time.step1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each digit is sent as that many pulses, and zero is one long vibration. The time always has two digits: 7 is sent as 07, which is one long vibration, a pause, then 7 pulses. For example, 13 is 1 pulse, a pause, then 3 pulses. Practice with the button below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada dígito se envía como esa cantidad de pulsos, y el cero es una vibración larga. El tiempo siempre tiene dos dígitos: el 7 se envía como 07, es decir, una vibración larga, una pausa y 7 pulsos. Por ejemplo, 13 es 1 pulso, una pausa y 3 pulsos. Practica con el botón de abajo."
          }
        }
      }
    },
    "instruction.time.step1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learn the vibrations"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprende las vibraciones"
          }
        }
      }
    },
    "instruction.time.step2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the spectator stops the stopwatch, the phone waits 2 seconds and sends the seconds. Three seconds later it sends the hundredths. To get each vibration when you are ready, turn on \"Face Down\" in Vibration Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando la persona detiene el cronómetro, el teléfono espera 2 segundos y envía los segundos. Tres segundos después envía las centésimas. Para recibir cada vibración cuando estés listo, activa \"Boca Abajo\" en Ajustes de Vibración."
          }
        }
      }
    },
    "instruction.time.step2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How the vibrations come"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo llegan las vibraciones"
          }
        }
      }
    },
    "instruction.time.step3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open \"Time Control\" and hold the phone with the screen facing the spectator. Make sure your fingers can feel the vibrations. Ask them to tap \"Start\" and to stop the stopwatch whenever they want. If they don't stop it, it stops by itself at 59.99."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre \"Control del Tiempo\" y sostén el teléfono con la pantalla hacia la persona. Asegúrate de que tus dedos puedan sentir las vibraciones. Pídele que toque \"Iniciar\" y que detenga el cronómetro cuando quiera. Si no lo detiene, se detiene solo en 59.99."
          }
        }
      }
    },
    "instruction.time.step3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold the phone"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostén el teléfono"
          }
        }
      }
    },
    "instruction.time.step4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait for the vibrations. First come the seconds, then the hundredths 3 seconds later. If \"Face Down\" is on, turn the phone face down to get the seconds, then do it again to get the hundredths."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera las vibraciones. Primero llegan los segundos y 3 segundos después las centésimas. Si \"Boca Abajo\" está activado, pon el teléfono boca abajo para recibir los segundos y hazlo otra vez para las centésimas."
          }
        }
      }
    },
    "instruction.time.step4.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get the vibrations"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe las vibraciones"
          }
        }
      }
    },
    "instruction.time.step5.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say the seconds first. Pause. Then say the hundredths."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di primero los segundos. Haz una pausa y luego di las centésimas."
          }
        }
      }
    },
    "instruction.time.step5.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say the time"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di el tiempo"
          }
        }
      }
    },
