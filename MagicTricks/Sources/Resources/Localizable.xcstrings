    "settings.help.noVibration.answer" : {
      "comment" : "Help answer; iOS gives no way to detect that vibrations are switched off, so it names both system switches.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The secret signal is a vibration, so it only works if vibrations are on. Check that Vibration is on in Settings > Accessibility > Touch, and System Haptics in Settings > Sounds & Haptics. Then try the signal again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
