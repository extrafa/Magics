      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To close a trick, press and hold the area at the top left of the screen. A tip shows you where it is when you open a trick. You can turn it off in the \"Show Exit Tip\" setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cerrar un truco, mantén presionada la zona en la parte superior izquierda de la pantalla. Un aviso te muestra dónde está al abrir un truco. Puedes desactivarlo en el ajuste \"Mostrar Consejo de Salida\"."
          }
        }
      }
    },
