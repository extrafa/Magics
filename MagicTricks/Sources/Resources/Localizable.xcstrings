        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejar que elija"
          }
        }
      }
    },
    "instruction.mindPattern.step5.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the spectator taps all the cards, the phone will start sending the animals one by one through vibrations. Each new animal comes every 4 seconds. Or turn on the trigger in Vibration Settings to receive them when you are ready — tap the button."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el espectador toque todas las cartas, el teléfono empezará a enviar los animales uno por uno mediante vibraciones. Cada nuevo animal llega cada 4 segundos. O activa el disparador en Ajustes de Vibración para recibirlos cuando estés listo: toca el botón."
          }
        }
      }
    },
    "instruction.mindPattern.step5.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get the signals"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibir las señales"
          }
        }
      }
    },
    "instruction.mindPattern.step6.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do not name the animals too fast. Pause between each one and speak slowly, as if you are really reading their mind. Example: \"You started with something small...\" pause \"Ant.\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No nombres los animales demasiado rápido. Haz una pausa entre cada uno y habla despacio, como si realmente estuvieras leyendo su mente. Ejemplo: \"Empezaste con algo pequeño...\" pausa \"Hormiga.\""
          }
        }
      }
    },
    "instruction.mindPattern.step6.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read their mind"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer su mente"
          }
        }
      }
    },
    "instruction.mindPattern.step7.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make the final animal feel special. Example: \"And at the end, your brain stopped on the one that felt most right to you...\" Pause — then name the last animal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz que el último animal se sienta especial. Ejemplo: \"Y al final, tu mente se detuvo en el que te pareció más correcto...\" Haz una pausa y luego nombra el último animal."
          }
        }
      }
    },
    "instruction.mindPattern.step7.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last animal"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Último animal"
          }
        }
      }
    },
