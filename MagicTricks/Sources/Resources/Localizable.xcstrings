    "instruction.magicGallery.effect" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The spectator chooses a number from 1 to 10. Then you let them open your real gallery — and the last photo contains the number they chose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El espectador elige un número del 1 al 10. Luego le dejas abrir tu galería real, y la última foto contiene el número que eligió."
          }
        }
      }
    },
    "instruction.magicGallery.secret" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During the trick, the app lets you secretly save a photo of the chosen number to your real gallery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante el truco, la app te permite guardar en secreto una foto del número elegido en tu galería real."
          }
        }
      }
    },
    "instruction.magicGallery.step1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the trick. Inside you will find all the number photos. Tap the photo you need, then tap the \"Save to Gallery\" button — the photo will be saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el truco. Dentro encontrarás todas las fotos con números. Toca la foto que necesitas y luego toca el botón \"Guardar en Galería\"; la foto se guardará."
          }
        }
      }
    },
    "instruction.magicGallery.step1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How it works"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo funciona"
          }
        }
      }
    },
    "instruction.magicGallery.step2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say: \"Do you believe in intuition? Sometimes we pick something without knowing why — as if it was already decided.\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di: \"¿Crees en la intuición? A veces elegimos algo sin saber por qué, como si ya estuviera decidido.\""
          }
        }
      }
    },
    "instruction.magicGallery.step2.title" : {
      "extractionState" : "manual",
