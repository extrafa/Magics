    "instruction.color.effect" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You hold the phone with the screen facing the spectator. They tap any colored card. Then you name the exact color they picked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostienes el teléfono con la pantalla hacia la persona. Toca cualquier carta de color. Luego dices el color exacto que eligió."
          }
        }
      }
    },
    "instruction.color.secret" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each color has a number. After the tap, the phone vibrates that many times. You count the pulses and match them to a color."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada color tiene un número. Después del toque, el teléfono vibra esa cantidad de veces. Cuentas los pulsos y los relacionas con un color."
          }
        }
      }
    },
    "instruction.color.step1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each color has a number of pulses: red is 1, green is 2, blue is 3 and yellow is 4. Practice feeling them with the button below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada color tiene un número de pulsos: rojo es 1, verde es 2, azul es 3 y amarillo es 4. Practica sintiéndolos con el botón de abajo."
          }
        }
      }
    },
    "instruction.color.step1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learn the vibrations"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprende las vibraciones"
          }
        }
      }
    },
    "instruction.color.step2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say: \"I will try to name the color you pick without looking at the screen.\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di: \"Voy a intentar nombrar el color que elijas sin mirar la pantalla.\""
          }
        }
      }
    },
    "instruction.color.step2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set the scene"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presenta el truco"
          }
        }
      }
    },
    "instruction.color.step3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open \"Color Sense\" and hold the phone with the screen facing the spectator. Hold it so your fingers can feel the vibrations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre \"Sentido del Color\" y sostén el teléfono con la pantalla hacia la persona. Sujétalo de forma que puedas sentir las vibraciones."
          }
        }
      }
    },
    "instruction.color.step3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold the phone"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma el teléfono"
          }
        }
      }
    },
    "instruction.color.step4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look away. Ask the spectator to tap any card."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira hacia otro lado y pídele a la persona que toque cualquier carta."
          }
        }
      }
    },
    "instruction.color.step4.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let them choose"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que elija"
          }
        }
      }
    },
    "instruction.color.step5.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The phone vibrates. Count the pulses and match the number to the color. If they tap another card after the vibration ends, the phone vibrates again. The last vibration is the one that counts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teléfono vibra. Cuenta los pulsos y relaciona el número con el color. Si toca otra carta cuando termina la vibración, el teléfono vibra de nuevo. Cuenta siempre la última vibración."
          }
        }
      }
    },
    "instruction.color.step5.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read the vibrations"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siente las vibraciones"
          }
        }
      }
    },
    "instruction.color.step6.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the spectator to touch your palm. Pause for a moment. Then name the color."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pídele a la persona que toque tu palma. Haz una pausa y luego di el color."
          }
        }
      }
    },
    "instruction.color.step6.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name the color"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombra el color"
          }
        }
      }
    },
    "instruction.color.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Color Sense"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentido del Color"
          }
        }
      }
    },
    "instruction.geo.effect" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You give your phone to a spectator. They see a list of cities and tap one. A new screen shows 10 cities, and theirs is one of them. They read all 10 out loud, in any order. Then you name the city they picked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le das tu teléfono a una persona. Ve una lista de ciudades y toca una. Se abre otra pantalla con 10 ciudades, y la que tocó es una de ellas. La persona lee las 10 en voz alta, en cualquier orden. Luego dices la ciudad que eligió."
          }
        }
      }
    },
    "instruction.geo.secret" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some letters can be drawn with straight lines only. Others need at least one curve. After they pick a city, the screen shows 9 cities that start with one type of letter and 1 city that starts with the other type. That 1 city is the one they picked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas letras se pueden dibujar solo con líneas rectas. Otras necesitan al menos una curva. Cuando la persona elige una ciudad, la pantalla muestra 9 ciudades que empiezan con un tipo de letra y 1 ciudad que empieza con el otro tipo. Esa ciudad es la que eligió."
          }
        }
      }
    },
    "instruction.geo.step1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Look at a letter and ask yourself: can I draw it with straight lines only? If yes, it is a \"straight\" letter. If it needs at least one curve, it is a \"curved\" letter.\n\n\"Straight\": A E F H I K L M N T V W X Y Z\n\"Curved\": B C D G J O P Q R S U\n\nYou don't need to memorize both groups. Look at the first letter of the city and ask yourself: does it have a curve?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira una letra y pregúntate: ¿puedo dibujarla solo con líneas rectas? Si es así, es una letra \"recta\". Si necesita al menos una curva, es una letra \"curva\".\n\n\"Rectas\": A E F H I K L M N T V W X Y Z\n\"Curvas\": B C D G J O P Q R S U\n\nNo necesitas memorizar los dos grupos. Mira la primera letra de la ciudad y pregúntate: ¿tiene alguna curva?"
          }
        }
      }
    },
    "instruction.geo.step1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learn the rule"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprende la regla"
          }
        }
      }
    },
    "instruction.geo.step2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open \"Geo Mentalism\" and tap \"Start\". A list of cities appears. Give the phone to the spectator and ask them to tap any city."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre \"Geo Mentalismo\" y toca \"Empezar\". Aparece una lista de ciudades. Dale el teléfono a la persona y pídele que toque cualquier ciudad."
          }
        }
      }
    },
    "instruction.geo.step2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the list"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la lista"
          }
        }
      }
    },
    "instruction.geo.step3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new screen opens with 10 cities. Tell them that 9 are random and 1 is the city they picked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se abre otra pantalla con 10 ciudades. Dile que 9 son al azar y 1 es la ciudad que eligió."
          }
        }
      }
    },
    "instruction.geo.step3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get the city"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtén la ciudad"
          }
        }
      }
    },
    "instruction.geo.step4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the spectator to read all 10 cities out loud. They can tap \"Shuffle\" first to change the order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pídele a la persona que lea las 10 ciudades en voz alta. Antes puede tocar \"Mezclar\" para cambiar el orden."
          }
        }
      }
    },
    "instruction.geo.step4.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read them out"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que las lea en voz alta"
          }
        }
      }
    },
    "instruction.geo.step5.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listen closely while they read. Each city starts with a letter. Nine of the cities start with the same type of letter and one starts with the other type. That one is their city."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escucha con atención mientras lee. Cada ciudad empieza con una letra. Nueve ciudades empiezan con el mismo tipo de letra y una con el otro tipo. Esa es su ciudad."
          }
        }
      }
    },
    "instruction.geo.step5.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find their city"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra su ciudad"
          }
        }
      }
    },
    "instruction.geo.step6.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When they finish reading, pause for a moment. Then name the city they picked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando termine de leer, haz una pausa. Luego di la ciudad que eligió."
          }
        }
      }
    },
    "instruction.geo.step6.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name the city"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombra la ciudad"
          }
        }
      }
    },
    "instruction.geo.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geo Mentalism"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geo Mentalismo"
          }
        }
      }
    },
    "instruction.magicGallery.effect" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the spectator to think of a number from 1 to 10 and say it out loud. Then ask them to open your gallery. The last photo shows their number."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pídele a la persona que piense un número del 1 al 10 y lo diga en voz alta. Luego pídele que abra tu galería. La última foto muestra su número."
          }
        }
      }
    },
    "instruction.magicGallery.secret" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When they say their number, you tap that many times on the phone screen in your pocket. The app saves the matching photo to your gallery. They see nothing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando dice su número, tocas esa cantidad de veces la pantalla del teléfono dentro de tu bolsillo. La app guarda la foto correspondiente en tu galería. La persona no ve nada."
          }
        }
      }
    },
    "instruction.magicGallery.step1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open \"Magic Gallery\" and tap \"Perform\". A dark screen opens. Put the phone in your pocket. To leave this screen later, press and hold its top-left corner. The standard set already has photos of the numbers 1 to 10. Don't take other photos with this phone in the 10 minutes before the reveal: the saved photo is dated 10 minutes earlier, so a newer photo would show up as the last one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre \"Galería Mágica\" y toca \"Realizar\". Se abre una pantalla oscura. Guarda el teléfono en tu bolsillo. Para salir de esta pantalla después, mantén pulsada su esquina superior izquierda. El set estándar ya tiene fotos de los números del 1 al 10. No tomes otras fotos con este teléfono en los 10 minutos previos a la revelación: la foto guardada lleva una fecha 10 minutos anterior, así que una foto más reciente aparecería como la última."
          }
        }
      }
    },
    "instruction.magicGallery.step1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get ready"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepárate"
          }
        }
      }
    },
    "instruction.magicGallery.step2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say: \"Pick any number from 1 to 10. Don't think too long. Just say it.\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di: \"Elige cualquier número del 1 al 10. No lo pienses demasiado. Solo dilo.\""
          }
        }
      }
    },
    "instruction.magicGallery.step2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask them to pick"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pídele que elija"
          }
        }
      }
    },
    "instruction.magicGallery.step3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The spectator says a number. Remember it. Say: \"Do you believe in intuition? Sometimes we pick something without knowing why.\" While you talk, tap the screen of the phone in your pocket. For example, if they said 7, tap 7 times. Each tap gives a light vibration. After a pause of about a second, the photo saves to your gallery and the phone gives a success vibration. A different, error vibration means it did not save, for example because there is no photo for that number. If you tap more than 10 times, the count starts over."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La persona dice un número. Recuérdalo. Di: \"¿Crees en la intuición? A veces elegimos algo sin saber por qué.\" Mientras hablas, toca la pantalla del teléfono dentro de tu bolsillo. Por ejemplo, si dijo 7, toca 7 veces. Cada toque da una vibración suave. Tras una pausa de aproximadamente un segundo, la foto se guarda en tu galería y el teléfono da una vibración de éxito. Una vibración de error distinta significa que no se guardó, por ejemplo porque no hay foto para ese número. Si tocas más de 10 veces, la cuenta empieza de nuevo."
          }
        }
      }
    },
    "instruction.magicGallery.step3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Talk and tap"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habla y toca"
          }
        }
      }
    },
    "instruction.magicGallery.step4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give the spectator your phone and say: \"Open my gallery.\" The last photo shows their number."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale tu teléfono a la persona y di: \"Abre mi galería.\" La última foto muestra su número."
          }
        }
      }
    },
    "instruction.magicGallery.step4.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show the reveal"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la revelación"
          }
        }
      }
    },
    "instruction.magicGallery.step5.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can swap the standard photos for your own. Use playing cards, symbols, or any image. Set them up before the show. Each slot number matches one photo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiar las fotos estándar por las tuyas. Usa cartas, símbolos o cualquier imagen. Configúralas antes de la función. Cada número de casilla corresponde a una foto."
          }
        }
      }
    },
    "instruction.magicGallery.step5.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use your own photos"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa tus propias fotos"
          }
        }
      }
    },
    "instruction.magicGallery.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Gallery"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galería Mágica"
          }
        }
      }
    },
    "instruction.phantomDraw.effect" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You give the spectator a phone and turn away. They draw a number on the screen. Then, without looking, you say the number they drew."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le das un teléfono a la persona y te das la vuelta. Dibuja un número en la pantalla. Luego, sin mirar, dices el número que dibujó."
          }
        }
      }
    },
    "instruction.phantomDraw.secret" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You use two phones. The spectator draws on one, and the other stays with you. When they draw, you see it on your phone in real time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usas dos teléfonos. La persona dibuja en uno y el otro se queda contigo. Cuando dibuja, lo ves en tu teléfono en tiempo real."
          }
        }
      }
    },
    "instruction.phantomDraw.step1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open \"Phantom Draw\" on both phones. On the phone you will give to the spectator, tap \"Give to spectator\". On your phone, tap \"This phone is mine\" and enter the two-digit code shown on the other phone. If iOS asks to allow the local network, allow it. Wait for both phones to connect. A canvas appears on both screens. Do this before the show and keep the phones in the same room."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre \"Dibujo Fantasma\" en los dos teléfonos. En el teléfono que le darás a la persona, toca \"Dar al espectador\". En tu teléfono, toca \"Este teléfono es mío\" e introduce el código de dos cifras que aparece en el otro teléfono. Si iOS pide permiso para la red local, permítelo. Espera a que ambos teléfonos se conecten. Aparecerá un lienzo en ambas pantallas. Hazlo antes de la función y mantén los teléfonos en la misma habitación."
          }
        }
      }
    },
    "instruction.phantomDraw.step1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect the phones"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta los teléfonos"
          }
        }
      }
    },
    "instruction.phantomDraw.step2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide your phone from the spectator and put it in your pocket. They must not see it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esconde tu teléfono de la persona y guárdalo en tu bolsillo. No debe verlo."
          }
        }
      }
    },
    "instruction.phantomDraw.step2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide your phone"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esconde tu teléfono"
          }
        }
      }
    },
    "instruction.phantomDraw.step3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give the spectator the other phone and say: \"Draw any number from 0 to 9 on the phone.\" Then turn away. Stay in the same room so the phones stay connected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale a la persona el otro teléfono y di: \"Dibuja cualquier número del 0 al 9 en el teléfono.\" Luego date la vuelta. Quédate en la misma habitación para que los teléfonos sigan conectados."
          }
        }
      }
    },
    "instruction.phantomDraw.step3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give them the phone"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale el teléfono"
          }
        }
      }
    },
    "instruction.phantomDraw.step4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While they draw, secretly check your phone: you see their number on the screen. When they finish, say: \"Your reflexes will help me understand what number you drew.\" Ask them to give you their hand, take it and look them in the eyes. Say each number from 0 to 9. Stop on the number they drew and say: \"That is the number you drew.\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras dibuja, mira tu teléfono en secreto: verás su número en la pantalla. Cuando termine, di: \"Tus reflejos me ayudarán a entender qué número dibujaste.\" Pídele que te dé la mano, tómala y mírale a los ojos. Di cada número del 0 al 9. Detente en el número que dibujó y di: \"Ese es el número que dibujaste.\""
          }
        }
      }
    },
    "instruction.phantomDraw.step4.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name the number"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di el número"
          }
        }
      }
    },
    "instruction.phantomDraw.step5.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If they drew a two-digit number like 15 or 23, don't worry. Use this method instead. Say: \"First I will guess the range.\" Then name the ten that holds their number: for 15 say \"It was between 10 and 20\", for 23 say \"between 20 and 30\". Say each number in that range. Stop on the number they drew and say: \"That is the number you drew.\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si dibujó un número de dos dígitos, como 15 o 23, no te preocupes. Usa este otro método. Di: \"Primero adivinaré el rango.\" Luego nombra la decena de su número: para 15 di \"Estaba entre 10 y 20\", para 23 di \"entre 20 y 30\". Di cada número de ese rango. Detente en el número que dibujó y di: \"Ese es el número que dibujaste.\""
          }
        }
      }
    },
    "instruction.phantomDraw.step5.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If they drew two digits"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si dibujó dos dígitos"
          }
        }
      }
    },
    "instruction.phantomDraw.step6.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you are done, close the trick on the spectator's phone: tap the trash button (\"Clear Drawing\") 4 times quickly. Holding the top-left corner, the usual way out, does not work on this screen, so a drawing can never close it by accident."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando termines, cierra el truco en el teléfono de la persona: toca 4 veces seguidas y rápido el botón de la papelera (\"Borrar Dibujo\"). La forma habitual de salir, mantener pulsada la esquina superior izquierda, no funciona en esta pantalla, para que un dibujo nunca la cierre por accidente."
          }
        }
      }
    },
    "instruction.phantomDraw.step6.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close the trick"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra el truco"
          }
        }
      }
    },
    "instruction.phantomDraw.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phantom Draw"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibujo Fantasma"
          }
        }
      }
    },
    "instruction.phase.demonstration" : {
