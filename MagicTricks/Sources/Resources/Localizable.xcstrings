    "instruction.time.effect" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The spectator starts and stops a stopwatch whenever they want. You then say the exact time — seconds and milliseconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El espectador inicia y detiene un cronómetro cuando quiera. Luego tú dices el tiempo exacto: segundos y milisegundos."
          }
        }
      }
    },
    "instruction.time.secret" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the spectator stops the stopwatch, the phone starts sending seconds and milliseconds through vibrations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el espectador detiene el cronómetro, el teléfono empieza a enviar los segundos y milisegundos mediante vibraciones."
          }
        }
      }
    },
    "instruction.time.step1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memorize the code: each digit is the number of pulses. Example: 03 = one long vibration, pause, 3 pulses. Practice right here — tap the button."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoriza el código: cada dígito es el número de pulsos. Ejemplo: 03 = una vibración larga, pausa, 3 pulsos. Practica aquí mismo: toca el botón."
          }
        }
      }
    },
    "instruction.time.step1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Learn the signals"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprender las señales"
          }
        }
      }
    },
    "instruction.time.step2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the spectator stops the stopwatch, the phone sends the seconds through vibrations. After 3 seconds — the milliseconds. Or turn on the trigger in Vibration Settings to receive the signals when you are ready — tap the button."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el espectador detiene el cronómetro, el teléfono envía los segundos mediante vibraciones. Después de 3 segundos, los milisegundos. O activa el disparador en Ajustes de Vibración para recibir las señales cuando estés listo: toca el botón."
          }
        }
      }
    },
    "instruction.time.step2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How signals come"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo llegan las señales"
          }
        }
      }
    },
    "instruction.time.step3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say: \"Let's try an experiment. I will try to control the moment when you stop the stopwatch.\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di: \"Probemos un experimento. Voy a intentar controlar el momento en que detienes el cronómetro.\""
          }
        }
      }
    },
    "instruction.time.step3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explain the trick"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explicar el truco"
          }
        }
      }
    },
    "instruction.time.step4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start the trick and hold the phone with the screen facing the spectator. Hold it so you can feel the vibrations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia el truco y sostén el teléfono con la pantalla mirando al espectador. Sujétalo de forma que puedas sentir las vibraciones."
          }
        }
      }
    },
    "instruction.time.step4.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take the phone"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomar el teléfono"
          }
        }
      }
    },
    "instruction.time.step5.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait for the vibrations — first the seconds, then the milliseconds 3 seconds later. If the trigger is on — turn the phone face down for the seconds, then do it again for the milliseconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera las vibraciones: primero los segundos y luego los milisegundos 3 segundos después. Si el disparador está activado, pon el teléfono boca abajo para los segundos y hazlo otra vez para los milisegundos."
          }
        }
      }
    },
    "instruction.time.step5.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get the signals"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibir las señales"
          }
        }
      }
    },
    "instruction.time.step6.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before saying the time, ask: \"Do you think that was a random choice?\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de decir el tiempo, pregunta: \"¿Crees que fue una elección aleatoria?\""
          }
        }
      }
    },
    "instruction.time.step6.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make them think"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hacerlos pensar"
          }
        }
      }
    },
    "instruction.time.step7.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say the seconds first. Pause — then the milliseconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di primero los segundos. Haz una pausa y luego los milisegundos."
          }
        }
      }
    },
    "instruction.time.step7.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
