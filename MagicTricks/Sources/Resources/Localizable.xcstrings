        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedir números"
          }
        }
      }
    },
    "instruction.calculatorPrediction.step5.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the spectator says a round number (200, 300) or a number with the same digits (111, 222), say: \"Let's try something more random.\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el espectador dice un número redondo (200, 300) o uno con cifras repetidas (111, 222), di: \"Probemos con algo más aleatorio.\""
          }
        }
      }
    },
    "instruction.calculatorPrediction.step5.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid simple numbers"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evitar números simples"
          }
        }
      }
    },
    "instruction.calculatorPrediction.step6.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the first number, the multiplication sign, then the second number. Press equals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce el primer número, el signo de multiplicación y luego el segundo número. Presiona igual."
