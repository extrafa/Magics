    "instruction.calculatorPrediction.effect" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before the trick starts, you write a number on paper or in your phone notes. The spectator says random three-digit numbers and you multiply them on your phone. The result matches your prediction."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de empezar el truco, escribes un número en papel o en las notas de tu teléfono. El espectador dice números aleatorios de tres cifras y tú los multiplicas en tu teléfono. El resultado coincide con tu predicción."
          }
        }
      }
    },
    "instruction.calculatorPrediction.secret" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You save a number inside the calculator before the trick starts. Whatever numbers the spectator says — the result will always be your number."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardas un número dentro de la calculadora antes de empezar el truco. No importa qué números diga el espectador: el resultado siempre será tu número."
          }
        }
      }
    },
    "instruction.calculatorPrediction.step1.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the trick and enter any 5-digit number. Then hold the AC button until the screen flashes. The number is now saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el truco e introduce cualquier número de 5 cifras. Luego mantén presionado el botón AC hasta que la pantalla parpadee. El número ya queda guardado."
          }
        }
      }
    },
    "instruction.calculatorPrediction.step1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save the number"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar el número"
          }
        }
      }
    },
    "instruction.calculatorPrediction.step2.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write the same number on paper or in your phone notes. Fold the paper or put the phone away so the spectator knows a prediction exists, but cannot see the number."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe el mismo número en papel o en las notas de tu teléfono. Dobla el papel o guarda el teléfono para que el espectador sepa que existe una predicción, pero no pueda ver el número."
          }
        }
      }
    },
    "instruction.calculatorPrediction.step2.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write the prediction"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribir la predicción"
          }
        }
      }
    },
    "instruction.calculatorPrediction.step3.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After saving, pressing equals will show your number. After that, the calculator works as normal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de guardarlo, al presionar igual aparecerá tu número. Luego la calculadora funcionará con normalidad."
          }
        }
      }
    },
    "instruction.calculatorPrediction.step3.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How it works"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo funciona"
          }
        }
      }
    },
    "instruction.calculatorPrediction.step4.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the spectator to say two random three-digit numbers. Each number must be 300 or less. A bigger number will give a 6-digit result, which cannot match your 5-digit prediction."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide al espectador que diga dos números aleatorios de tres cifras. Cada número debe ser 300 o menor. Un número mayor dará un resultado de 6 cifras, que no puede coincidir con tu predicción de 5 cifras."
          }
        }
      }
    },
    "instruction.calculatorPrediction.step4.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask for numbers"
          }
